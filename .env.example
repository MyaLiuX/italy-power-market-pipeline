# Copy this file to .env and fill in your own values.
# .env is gitignored — it holds secrets and machine-specific paths.

# ENTSO-E Transparency Platform API key.
# Register at https://transparency.entsoe.eu/ and email
# transparency@entsoe.eu to request API access.
ENTSOE_API_KEY=

# GCP project that owns the bucket and BigQuery datasets.
GCP_PROJECT_ID=

# GCS bucket used as the raw landing zone.
# Must match bucket_name in terraform/terraform.tfvars.
GCS_BUCKET_NAME=